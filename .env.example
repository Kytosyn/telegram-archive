# Telegram API credentials (from my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+1234567890
TELEGRAM_SESSION_NAME=telegram_archive

# Paths
DATABASE_PATH=./data/telegram.db
MEDIA_DIR=./media
INDEX_DIR=./index

# Server settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Rate limiting (seconds between messages)
RATE_LIMIT_SECONDS=0.05
MAX_MESSAGES_PER_SECOND=3

# Media download settings
# MEDIA_MODE: "all" | "none" | "selective"
# - "all": download all media (default)
# - "none": text-only, skip all media downloads
# - "selective": only download media from chats in MEDIA_ALLOW_LIST
MEDIA_MODE=all

# MEDIA_ALLOW_LIST: comma-separated chat IDs or usernames (for selective mode)
# Examples: "123456789,johndoe,-1001234567890" or "@johndoe,channelusername"
MEDIA_ALLOW_LIST=

# MAX_MEDIA_SIZE_MB: skip media larger than this in MB (0 = unlimited)
MAX_MEDIA_SIZE_MB=0